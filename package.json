{
  "name": "dsh-desktop",
  "version": "0.4.1",
  "description": "DeepSeek Harness desktop app — cross-platform wrapper for the dsh web UI",
  "author": {
    "name": "DeepSeek Harness Desktop",
    "email": "WaHaiLong@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "fetch:node": "node scripts/fetch-node.mjs",
    "fetch:uv": "node scripts/fetch-uv.mjs",
    "runtime:install": "npm install --prefix resources/dsh",
    "runtime:patch": "node scripts/patch-runtime.mjs",
    "runtime:pack": "node scripts/pack-runtime.mjs",
    "build": "npm run fetch:node && npm run fetch:uv && npm run runtime:install && npm run runtime:patch && npm run runtime:pack && npm run dist",
    "dist": "electron-builder --publish never",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "asar": true,
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "WaHaiLong",
      "repo": "dsh-desktop"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/node",
        "to": "node"
      },
      {
        "from": "resources/dsh-runtime.tar.gz",
        "to": "dsh-runtime.tar.gz"
      },
      {
        "from": "resources/uv",
        "to": "uv"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "DeepSeekHarness-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "DeepSeekHarness-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "artifactName": "DeepSeekHarness-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
